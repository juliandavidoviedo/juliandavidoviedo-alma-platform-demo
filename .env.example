# Client-exposed — never put secrets here (no VITE_API_KEY, no VITE_APPS_SCRIPT_URL).
# demo  (default if unset) — in-memory mocks, no network calls.
# pilot — real persistence via /.netlify/functions/api -> Apps Script -> Sheets/Drive.
VITE_APP_MODE=demo

# Server-side only (Netlify Function environment, NOT prefixed with VITE_ —
# set these in the Netlify UI/CLI, never committed, never sent to the browser):
#   APPS_SCRIPT_URL     — the deployed Apps Script Web App /exec URL
#   BACKEND_API_KEY     — matches the backend's Config.API_KEY / pilot Script Property
